# MongoDB Configuration
# Pour MongoDB local (par défaut)
MONGO_URI=mongodb://localhost:27017/

# Pour MongoDB Atlas (cloud)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/moviehub

# Neo4j Configuration (optionnel pour la partie MongoDB)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Notes:
# - Copier ce fichier en .env et ajuster les valeurs
# - Ne jamais commiter le fichier .env (contient des secrets)
# - Pour MongoDB local, la valeur par défaut fonctionne directement
